{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Edit(./**)",
      "WebSearch",
      "WebFetch",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git branch --show-current)",
      "Bash(git switch arbeit)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git pull)",
      "Bash(git pull origin arbeit)",
      "Bash(git push origin arbeit)",
      "Bash(git push -u origin arbeit)"
    ],
    "deny": [
      "Bash(git push *main*)",
      "Bash(git push *--force*)",
      "Bash(git push *-f*)",
      "Bash(git push *+*)",
      "Bash(git push --mirror*)",
      "Bash(rm *)",
      "Bash(rmdir *)"
    ]
  }
}
